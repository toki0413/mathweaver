    "/api/conjecture/translate": {
      "post": {
        "summary": "Nl To Z3 Translate",
        "description": "Translate a natural-language conjecture into a Z3 verification task.\n\nPipeline: NL → StructuredConjecture → Z3 → Verdict.\nUses the LLM (if configured) to parse the claim, then Z3 for\nformal verification. Falls back to rule-based parsing offline.\n\nResponse structure:\n- headline: human-readable summary of the verdict\n- verdict: confirmed / refuted / undecidable\n- counter_example: the refuting structure (if refuted)\n- explanation: why Z3 reached this verdict\n- smt_summary: the Z3 encoding used (human-readable)\n- structured_parse: the parsed conjecture structure",
        "operationId": "nl_to_z3_translate_api_conjecture_translate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NLToZ3Request"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Nl To Z3 Translate Api Conjecture Translate Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
