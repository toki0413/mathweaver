    "/api/historical/narrative": {
      "post": {
        "summary": "Get Historical Narrative",
        "description": "Retrieve a historical narrative for a concept via RAG.\n\nUses the ``HistoricalAgent``'s BM25 retrieval to find relevant\nmathematical-history entries, then returns a narrative summary plus\nthe raw retrieved entries.\n\nReturns:\n    JSON with ``narrative`` (str), ``entries`` (list of\n    ``{title, content, score}``), ``node_id``, and\n    ``retrieval_method``.",
        "operationId": "get_historical_narrative_api_historical_narrative_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HistoricalRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Historical Narrative Api Historical Narrative Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/curriculum/compare": {
