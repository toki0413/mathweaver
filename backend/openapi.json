        "summary": "Compare Curriculum Structures",
        "description": "Compare how a concept appears across different curriculum levels.\n\nSearches each specified curriculum DAG for nodes whose name or\ndescription contains ``concept_keyword``, then returns a structured\ncomparison highlighting the concept's structural role in each\ncurriculum.\n\nReturns:\n    JSON with ``comparisons`` (list of ``{level, concept_id,\n    concept_name, description, structural_type}``) and ``keyword``.",
        "operationId": "compare_curriculum_structures_api_curriculum_compare_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CurriculumCompareRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
