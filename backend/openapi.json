  "components": {
    "schemas": {
      "CayleyTableRequest": {
        "properties": {
          "table": {
            "items": {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            "type": "array",
            "minItems": 1,
            "title": "Table"
          }
        },
        "type": "object",
        "required": [
          "table"
        ],
        "title": "CayleyTableRequest"
      },
      "CurriculumCompareRequest": {
        "properties": {
          "levels": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Levels",
            "default": [
              "group_theory",
              "linear_algebra",
              "number_theory"
            ]
          },
          "concept_keyword": {
            "type": "string",
            "title": "Concept Keyword",
            "default": "isomorphism"
          }
        },
        "type": "object",
        "title": "CurriculumCompareRequest"
      },
      "GrillAnswerRequest": {
        "properties": {
          "qid": {
            "type": "string",
            "title": "Qid"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "is_correct": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Correct"
          },
          "response_time_ms": {
            "type": "number",
            "title": "Response Time Ms",
            "default": 5000.0
          }
        },
        "type": "object",
        "required": [
          "qid",
          "answer"
        ],
        "title": "GrillAnswerRequest"
      },
      "GrillStartRequest": {
        "properties": {
          "student_id": {
            "type": "string",
            "title": "Student Id",
            "default": "grill_student"
          },
          "curriculum_level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Curriculum Level"
          }
        },
        "type": "object",
        "title": "GrillStartRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HistoricalRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "node_id": {
            "type": "string",
            "title": "Node Id",
            "default": "group_definition"
          },
          "top_k": {
            "type": "integer",
            "title": "Top K",
            "default": 3
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "HistoricalRequest"
      },
      "NLToZ3Request": {
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1,
            "title": "Claim"
          }
        },
        "type": "object",
        "required": [
          "claim"
        ],
        "title": "NLToZ3Request"
      },
      "ProofSubmitRequest": {
        "properties": {
          "theorem_id": {
            "type": "string",
            "title": "Theorem Id"
          },
          "student_steps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Student Steps"
          },
          "curriculum_level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Curriculum Level"
          }
        },
        "type": "object",
        "required": [
          "theorem_id",
          "student_steps"
        ],
