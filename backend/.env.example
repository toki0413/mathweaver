# ⚠️ 本文件仅适用于 Python 后端（开发模式）。
# Electron 桌面应用请通过 应用内设置面板 配置 API，或在 desktop/ 目录下创建 .env 文件。
# 支持的环境变量前缀：MATHWEAVER_LLM_* 或 LLM_*

# MathWeaver Configuration
# Copy this file to .env and fill in your values.

# --- LLM Configuration ---
# Provider: "mock" for deterministic testing, "openai_compatible" for real LLM
MATHWEAVER_LLM_PROVIDER=mock

# API Key (required for real LLM; leave empty for mock)
# Supports DeepSeek, GLM, Qwen, and any OpenAI-compatible API
MATHWEAVER_LLM_API_KEY=

# Base URL (default: DeepSeek)
MATHWEAVER_LLM_BASE_URL=https://api.deepseek.com/v1

# Model name
MATHWEAVER_LLM_MODEL=deepseek-chat

# Temperature (0.0 = deterministic, 1.0 = creative)
MATHWEAVER_LLM_TEMPERATURE=0.7

# --- Database ---
# SQLite path; ":memory:" for ephemeral, or a file path for persistence
MATHWEAVER_DB_PATH=mathweaver.db

# --- Server ---
MATHWEAVER_HOST=0.0.0.0
MATHWEAVER_PORT=8000
MATHWEAVER_LOG_LEVEL=INFO

# --- CORS ---
# Comma-separated list of allowed origins, or * for all
MATHWEAVER_CORS_ORIGINS=*
