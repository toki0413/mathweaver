<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow JIT execution (needed for V8 in Electron renderer) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Allow unsigned executable memory (V8 / Chromium requirement) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Allow loading of unsigned dylibs (better-sqlite3 native module) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Network access for LLM API calls -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Read/write user documents (session save/load) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
