# MathWeaver Electron 应用环境变量配置
# 
# 方式一（推荐）：启动应用后在「设置」面板中配置 API
# 方式二：在此文件中填写，或设置系统环境变量
#
# 环境变量在 electron-store 中无 API Key 时作为回退读取

# LLM 提供商：mock | openai_compatible | ollama
LLM_PROVIDER=mock

# API Key（openai_compatible 必填，ollama 无需）
LLM_API_KEY=

# API Base URL（OpenAI 兼容端点）
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名称
LLM_MODEL=deepseek-chat

# 采样温度（0.0-2.0）
LLM_TEMPERATURE=0.7

# 最大响应 token 数
LLM_MAX_TOKENS=2048

# 也支持 MATHWEAVER_LLM_* 前缀（与 Python 后端兼容）
# MATHWEAVER_LLM_API_KEY=...
# MATHWEAVER_LLM_BASE_URL=...
# MATHWEAVER_LLM_MODEL=...
# MATHWEAVER_LLM_PROVIDER=...
